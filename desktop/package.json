{
  "name": "plusmusic-pro-desktop",
  "productName": "PlusMusic Pro",
  "version": "1.0.0",
  "description": "PlusMusic Pro para Windows, macOS y Linux",
  "main": "main.js",
  "author": "PlusMusic",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.plusmusic.desktop",
    "productName": "PlusMusic Pro",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../www", "to": "www", "filter": ["**/*"] }],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "category": "public.app-category.music", "icon": "build/icon.png" },
    "linux": { "target": ["AppImage", "deb"], "category": "Audio", "icon": "build/icon.png", "maintainer": "PlusMusic" }
  }
}
